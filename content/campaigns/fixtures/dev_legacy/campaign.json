  "consequenceRules": [
    {
      "id": "rule_merchant_murder",
      "event": "ENTITY_DEATH",
      "conditions": {
        "targetEntityId": "npc_dev_merchant_lycus"
      },
      "outcomes": {
        "setFlags": {
          "merchant_lycus_dead": true,
          "haven_shop_closed": true
        },
        "modifyReputation": {
          "faction_dev_haven": -50,
          "faction_dev_guards": -60
        },
        "failQuest": "quest_dev_merchant_delivery",
        "transcript": {
          "speaker": "World Consequence",
          "text": "Merchant Lycus falls dead in a pool of blood! The shop's heavy iron shutters slam shut permanently. Word spreads rapidly: Haven Watch Captain is conducting a murder investigation!",
          "style": "entry-consequence"
        },
        "addJournalChronicle": {
          "title": "Murder of Merchant Lycus",
          "text": "Slew the prominent Haven merchant Lycus. The shop is shuttered and the town watch is on high alert."
        },
        "scheduleEvent": {
          "id": "event_curfew",
          "delayHours": 4,
          "title": "Haven Watch Curfew Enforced",
          "text": "Town watch horns sound across Haven! Dusk curfew is enforced following Merchant Lycus' murder.",
          "setFlags": {
            "dev_haven_curfew_active": true
          }
        }
      }
    },
    {
      "id": "rule_questgiver_murder",
      "event": "ENTITY_DEATH",
      "conditions": {
        "targetEntityId": "npc_dev_elena_scholar"
      },
      "outcomes": {
        "setFlags": {
          "elena_scholar_dead": true
        },
        "modifyReputation": {
          "faction_dev_haven": -30
        },
        "transcript": {
          "speaker": "World Consequence",
          "text": "Scholar Elena drops lifeless. Her research journal rolls across the floor. You can search her body to discover the notes she was guarding, unlocking an alternate path for the Sunstone quest!",
          "style": "entry-consequence"
        },
        "addJournalChronicle": {
          "title": "Death of Scholar Elena",
          "text": "Scholar Elena was slain. Her research notes on the Sunstone can be retrieved directly from her belongings."
        }
      }
    }
  ],
  "settings": {
    "allowAnyEntityCombat": true,
    "lockpickingEnabled": true,
    "randomEncountersEnabled": true,
    "livingWorldSimulation": true
