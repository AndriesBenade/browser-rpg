{
  "dialogues": {
    "dialogue_dev_odile": {
      "greeting": "Name, purpose, and please don't touch the golem.",
      "nodes": {
        "root": {
          "text": "Odile Marsh looks at you over a ledger the size of a door.",
          "choices": [
            {
              "label": "What are the trials?",
              "target": "node_trials",
              "condition": {
                "questActive": "quest_dev_trials"
              }
            },
            {
              "label": "Could I borrow the practice key? (Persuade)",
              "check": {
                "skill": "persuasion",
                "attribute": "charisma",
                "dc": 14,
                "success": "node_key_yes",
                "failure": "node_key_no"
              },
              "condition": {
                "notHasItem": "item_dev_practice_key",
                "questActive": "quest_dev_trials"
              }
            },
            {
              "label": "The Guild Master said I could skip the lockbox. (Lie)",
              "check": {
                "skill": "deception",
                "attribute": "charisma",
                "dc": 15,
                "success": "node_lie_yes",
                "failure": "node_lie_no"
              },
              "condition": {
                "notHasItem": "item_dev_practice_key",
                "questActive": "quest_dev_trials"
              }
            },
            {
              "label": "The ledger is full.",
              "target": "node_licence",
              "condition": {
                "questStage": {
                  "questId": "quest_dev_trials",
                  "stage": "report"
                }
              }
            },
            {
              "label": "What's wrong with the lighthouse?",
              "target": "node_lighthouse",
              "condition": {
                "questNotDone": true,
                "questId": "quest_dev_lantern"
              }
            },
            {
              "label": "Is there a Guild whistle going spare?",
              "target": "node_whistle",
              "condition": {
                "minStanding": "friendly",
                "notHasItem": "item_dev_guild_whistle"
              }
            },
            {
              "label": "The lantern is lit.",
              "target": "node_epilogue",
              "condition": {
                "questCompleted": "quest_dev_lantern"
              }
            },
            {
              "label": "Good day, Examiner.",
              "target": "exit"
            }
          ]
        },
        "node_trials": {
          "text": "Ten lines. Fight, lock, words, search, trade, craft, a hands-on challenge, the Bog Stone, a companion, a night in the wild. Any order. Come back when every line is signed.",
          "giveItem": "item_dev_trial_ledger",
          "choices": [
            {
              "label": "Sounds simple.",
              "target": "root"
            },
            {
              "label": "Farewell.",
              "target": "exit"
            }
          ]
        },
        "node_key_yes": {
          "text": "She sighs and slides a small key across the desk. 'Technically allowed. Spiritually disappointing.'",
          "giveItem": "item_dev_practice_key",
          "choices": [
            {
              "label": "Thank you!",
              "target": "root"
            }
          ]
        },
        "node_key_no": {
          "text": "'No. Picks are under the counter at Tamsin's.' She goes back to her ledger. You will have to wait a while before asking again.",
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_lie_yes": {
          "text": "'Did he now.' She looks at you for a long moment, then hands over the key. 'Then you won't mind if I check.' You definitely mind.",
          "giveItem": "item_dev_practice_key",
          "choices": [
            {
              "label": "...Thanks.",
              "target": "root"
            }
          ]
        },
        "node_lie_no": {
          "text": "'The Guild Master,' says Odile, 'has been dead for nine years.' She writes something in the margin of your ledger. It is not a compliment.",
          "disposition": -10,
          "choices": [
            {
              "label": "Ah.",
              "target": "root"
            }
          ]
        },
        "node_licence": {
          "text": "She reads every line, initials the last, and hands you a brass ring. 'Welcome to the Guild, Wayfarer. Try not to die in the first week; the paperwork is awful.'",
          "completeQuest": "quest_dev_trials",
          "consumeItem": "item_dev_trial_ledger",
          "choices": [
            {
              "label": "I'll do my best.",
              "target": "root"
            },
            {
              "label": "Farewell.",
              "target": "exit"
            }
          ]
        },
        "node_lighthouse": {
          "text": "The lantern on Gull Rock went out a month ago and the keeper hasn't been seen since. Ships are running aground and the fog brings wisps right into town. Captain Garrow has the details, and the key.",
          "addJournalKnowledge": {
            "title": "Lanternfall",
            "text": "The Gull Rock lantern went out a month ago; the keeper vanished. Captain Garrow knows more."
          },
          "revealRumour": "loc_dev_gull_rock",
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_whistle": {
          "text": "'You've earned it.' A brass Guild whistle. 'Blow it before a fight and watch them flinch.'",
          "giveItem": "item_dev_guild_whistle",
          "setFlags": {
            "has_guild_whistle": true
          },
          "choices": [
            {
              "label": "Thank you.",
              "target": "root"
            }
          ]
        },
        "node_epilogue": {
          "text": "'I saw it from my window. The whole town cried. I did not cry. There was dust.' She very nearly smiles.",
          "choices": [
            {
              "label": "Farewell.",
              "target": "exit"
            }
          ]
        }
      }
    },
    "dialogue_dev_garrow": {
      "greeting": "Watch business or ferry business? Make it quick, the fog's coming in.",
      "nodes": {
        "root": {
          "text": "Captain Garrow chews his moustache and looks out at Gull Rock.",
          "choices": [
            {
              "label": "What happened to the lighthouse?",
              "target": "node_lighthouse",
              "condition": {
                "questStage": {
                  "questId": "quest_dev_lantern",
                  "stage": "ask_around"
                }
              }
            },
            {
              "label": "Could the Watch lend me the lighthouse key?",
              "target": "node_key_trust",
              "condition": {
                "minStanding": "trusted",
                "notHasItem": "item_dev_lighthouse_key",
                "questActive": "quest_dev_lantern"
              }
            },
            {
              "label": "Give me the key. I'm the only one going out there. (Persuade)",
              "check": {
                "skill": "persuasion",
                "attribute": "charisma",
                "dc": 15,
                "success": "node_key_yes",
                "failure": "node_key_no"
              },
              "condition": {
                "notHasItem": "item_dev_lighthouse_key",
                "questActive": "quest_dev_lantern"
              }
            },
            {
              "label": "The Guild sent me for the key. (Lie)",
              "check": {
                "skill": "deception",
                "attribute": "charisma",
                "dc": 14,
                "success": "node_key_lie_yes",
                "failure": "node_key_lie_no"
              },
              "condition": {
                "notHasItem": "item_dev_lighthouse_key",
                "questActive": "quest_dev_lantern"
              }
            },
            {
              "label": "Any bounties going?",
              "target": "node_bounty",
              "condition": {
                "questNotStarted": "quest_dev_bounty"
              }
            },
            {
              "label": "The lurker is dead.",
              "target": "node_bounty_paid",
              "condition": {
                "questStage": {
                  "questId": "quest_dev_bounty",
                  "stage": "claim"
                }
              }
            },
            {
              "label": "Anyone need help?",
              "target": "node_pip",
              "condition": {
                "questNotStarted": "quest_dev_stranded"
              }
            },
            {
              "label": "Pip is home safe.",
              "target": "node_pip_done",
              "condition": {
                "questStage": {
                  "questId": "quest_dev_stranded",
                  "stage": "report_rescue"
                }
              }
            },
            {
              "label": "I know who runs the smuggling in Saltreed.",
              "target": "node_smugglers",
              "condition": {
                "questActive": "quest_dev_smugglers",
                "flag": "jory_arrested",
                "expected": false
              }
            },
            {
              "label": "As you were, Captain.",
              "target": "exit"
            }
          ]
        },
        "node_lighthouse": {
          "text": "Old Corwin, the keeper, said the bell had started ringing by itself. Went down to see. Lantern's been dark since. You'll need a boat from Saltreed, or the cliff stair off Thornback if you can find it, and the key. I hold the key. I don't hand it to strangers.",
          "updateQuest": {
            "questId": "quest_dev_lantern",
            "objectiveId": "obj_ask_garrow",
            "completed": true
          },
          "addJournalKnowledge": {
            "title": "The Keeper's Bell",
            "text": "Keeper Corwin went down to silence a bell that rang by itself and never came back. Routes to Gull Rock: a boat from Saltreed, or a cliff stair on Thornback. Garrow has the lighthouse key."
          },
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_key_trust": {
          "text": "'You've done right by this town.' He unhooks a long bronze key from his belt. 'Bring it back.'",
          "giveItem": "item_dev_lighthouse_key",
          "choices": [
            {
              "label": "I will.",
              "target": "root"
            }
          ]
        },
        "node_key_yes": {
          "text": "He stares at you, then at the fog, then sighs and hands it over. 'Fine. Someone has to. Don't make me regret it.'",
          "giveItem": "item_dev_lighthouse_key",
          "choices": [
            {
              "label": "You won't.",
              "target": "root"
            }
          ]
        },
        "node_key_no": {
          "text": "'No. Do something for this town first.' He turns back to the window. He won't hear it again today.",
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_key_lie_yes": {
          "text": "'The Guild, eh? About time they did something.' He hands you the key without a second look.",
          "giveItem": "item_dev_lighthouse_key",
          "choices": [
            {
              "label": "Very kind.",
              "target": "root"
            }
          ]
        },
        "node_key_lie_no": {
          "text": "'Odile was in here an hour ago and said nothing of the sort.' His hand drifts to his falchion. 'Get out of my watch house.'",
          "disposition": -15,
          "modifyReputation": {
            "faction_dev_watch": -5
          },
          "choices": [
            {
              "label": "Leaving.",
              "target": "exit"
            }
          ]
        },
        "node_bounty": {
          "text": "A fogback lurker in the Old Moss. Took two goats and a very loud man. Thirty-five drachmae for its tongue.",
          "startQuest": "quest_dev_bounty",
          "choices": [
            {
              "label": "I'll get it.",
              "target": "root"
            }
          ]
        },
        "node_bounty_paid": {
          "text": "'Good riddance.' He counts out the bounty.",
          "completeQuest": "quest_dev_bounty",
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_pip": {
          "text": "Pip Tallow went up Thornback to look at the lighthouse and never came down. Storm's coming. If you're going, go now.",
          "startQuest": "quest_dev_stranded",
          "choices": [
            {
              "label": "On my way.",
              "target": "root"
            }
          ]
        },
        "node_pip_done": {
          "text": "'Thank the Warden.' He shakes your hand so hard your shoulder clicks. 'The Watch owes you.'",
          "completeQuest": "quest_dev_stranded",
          "disposition": 15,
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_smugglers": {
          "text": "'Jory Vane. Of course it's Jory Vane.' He makes a note. 'If you can bring her in, the Watch will be grateful.'",
          "addJournalKnowledge": {
            "title": "The Watch and Jory",
            "text": "Garrow would be grateful if Jory Vane were brought in."
          },
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        }
      }
    },
    "dialogue_dev_tamsin": {
      "greeting": "Welcome to the Quill & Candle! If we don't have it, you don't need it. If you do need it, we'll order it.",
      "nodes": {
        "root": {
          "text": "Tamsin is up a ladder, pricing jars of pickled eel.",
          "choices": [
            {
              "label": "Show me what you've got.",
              "target": "node_browse"
            },
            {
              "label": "Any errands?",
              "target": "node_errand",
              "condition": {
                "questNotStarted": "quest_dev_parcel"
              }
            },
            {
              "label": "Your honey, as promised.",
              "target": "node_honey",
              "condition": {
                "hasItem": "item_dev_honey_crate",
                "questStage": {
                  "questId": "quest_dev_parcel",
                  "stage": "deliver"
                }
              }
            },
            {
              "label": "Heard anything interesting?",
              "target": "node_rumour",
              "condition": {
                "minStanding": "friendly"
              }
            },
            {
              "label": "Bye, Tamsin.",
              "target": "exit"
            }
          ]
        },
        "node_browse": {
          "text": "Browse away! Mind the eels.",
          "openTrade": true,
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_errand": {
          "text": "Sister Bramble owes me a crate of honey and I'm not walking to Willowmere with my knees. Fetch it and I'll pay you.",
          "startQuest": "quest_dev_parcel",
          "choices": [
            {
              "label": "Leave it with me.",
              "target": "root"
            }
          ]
        },
        "node_honey": {
          "text": "'Oh, lovely. Not a jar broken!' She pays you on the spot.",
          "consumeItem": "item_dev_honey_crate",
          "updateQuest": {
            "questId": "quest_dev_parcel",
            "objectiveId": "obj_deliver_crate",
            "completed": true
          },
          "completeQuest": "quest_dev_parcel",
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_rumour": {
          "text": "Between us? Grandmother Rook says there's a chapel under the Old Moss. And Fennick's been buying a lot of brandy for a man who doesn't drink.",
          "revealRumour": "loc_dev_sunken_chapel",
          "choices": [
            {
              "label": "Interesting.",
              "target": "root"
            }
          ]
        }
      }
    },
    "dialogue_dev_fennick": {
      "greeting": "Ah. A person of taste. Or at least a person.",
      "nodes": {
        "root": {
          "text": "Fennick leans on a barrel that is not his.",
          "choices": [
            {
              "label": "What are you selling?",
              "target": "node_browse"
            },
            {
              "label": "Who runs Saltreed Cove?",
              "target": "node_saltreed"
            },
            {
              "label": "Teach me a trick or two. (Wits)",
              "check": {
                "skill": null,
                "attribute": "intelligence",
                "dc": 12,
                "success": "node_trick",
                "failure": "node_no_trick"
              }
            },
            {
              "label": "Later, Fennick.",
              "target": "exit"
            }
          ]
        },
        "node_browse": {
          "text": "Everything is legitimate. Some of it is even legal.",
          "openTrade": true,
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_saltreed": {
          "text": "Jory Vane. Charming woman. Three knives you can see. If you need to get to Gull Rock, she has boats, and she always wants something.",
          "revealRumour": "loc_dev_saltreed",
          "addJournalKnowledge": {
            "title": "Jory Vane",
            "text": "Jory Vane runs Saltreed Cove and has boats that could reach Gull Rock."
          },
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_trick": {
          "text": "He shows you how to palm a coin and how to look honest while doing it. You feel sharper (+2 on your next check).",
          "inspiration": true,
          "choices": [
            {
              "label": "Neat.",
              "target": "root"
            }
          ]
        },
        "node_no_trick": {
          "text": "'Watch the hand, not the coin. No, the other hand. No...' He gives up. Come back when you're paying attention.",
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        }
      }
    },
    "dialogue_dev_bramble": {
      "greeting": "Mind the bees, dear. They mind you.",
      "nodes": {
        "root": {
          "text": "Sister Bramble is mending a hive with her bare hands while bees walk on her fingers.",
          "choices": [
            {
              "label": "What do you sell?",
              "target": "node_browse"
            },
            {
              "label": "Is something wrong with the hives?",
              "target": "node_honey_thief",
              "condition": {
                "questNotStarted": "quest_dev_honey"
              }
            },
            {
              "label": "The bear won't be back.",
              "target": "node_bear_done",
              "condition": {
                "questStage": {
                  "questId": "quest_dev_honey",
                  "stage": "tell_bramble"
                }
              }
            },
            {
              "label": "Tamsin sent me for her honey.",
              "target": "node_crate",
              "condition": {
                "questStage": {
                  "questId": "quest_dev_parcel",
                  "stage": "fetch"
                }
              }
            },
            {
              "label": "Tell me about the Hive Mother.",
              "target": "node_hive_mother"
            },
            {
              "label": "Goodbye, Sister.",
              "target": "exit"
            }
          ]
        },
        "node_browse": {
          "text": "Tonics, mead, wax and a satchel for anyone who wants to learn herb-craft.",
          "openTrade": true,
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_honey_thief": {
          "text": "Something big has been tearing the hives open at night and walking off toward Thornback with the comb. Bristle bear, I'd wager. Make it stop, dear, but be kind if you can.",
          "startQuest": "quest_dev_honey",
          "choices": [
            {
              "label": "I'll see to it.",
              "target": "root"
            }
          ]
        },
        "node_bear_done": {
          "text": "'Bless you.' She presses a wax amulet into your hand. 'From the Hive Mother. She noticed.'",
          "completeQuest": "quest_dev_honey",
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_crate": {
          "text": "'Here, dear. Tell Tamsin she still owes me for the last one.' A heavy crate of crocks.",
          "giveItem": "item_dev_honey_crate",
          "updateQuest": {
            "questId": "quest_dev_parcel",
            "objectiveId": "obj_get_crate",
            "completed": true
          },
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_hive_mother": {
          "text": "She is patient, she remembers, and she likes mead poured on her stones. Do that, and the Sisters will bless you. Grind a remedy while you rest here and she guides your hand.",
          "addJournalKnowledge": {
            "title": "The Hive Mother",
            "text": "Pour mead on the Willowmere shrine stones for her favour; the Sisters bless those who make offerings."
          },
          "piety": {
            "hive_mother": 1
          },
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        }
      }
    },
    "dialogue_dev_rook": {
      "greeting": "Another one come to bother the Stone. Sit. Mind the eels.",
      "nodes": {
        "root": {
          "text": "Grandmother Rook fishes with no hook and catches nothing, contentedly.",
          "choices": [
            {
              "label": "What is the Bog Stone?",
              "target": "node_stone"
            },
            {
              "label": "Trade you an eel for the Stone's answer.",
              "target": "node_answer_eel",
              "condition": {
                "hasItem": "item_dev_smoked_eel",
                "flag": "rook_told_answer",
                "expected": false
              }
            },
            {
              "label": "Please, Grandmother. Just a hint? (Persuade)",
              "check": {
                "skill": "persuasion",
                "attribute": "charisma",
                "dc": 13,
                "success": "node_answer_free",
                "failure": "node_answer_no"
              },
              "condition": {
                "flag": "rook_told_answer",
                "expected": false
              }
            },
            {
              "label": "Is there anything under the bog?",
              "target": "node_chapel"
            },
            {
              "label": "Goodbye, Grandmother.",
              "target": "exit"
            }
          ]
        },
        "node_stone": {
          "text": "It asks a riddle. Everyone gets it wrong, then everyone stands about looking clever. Answer it and the old causeway comes up. Very dramatic.",
          "startQuest": "quest_dev_bog_stone",
          "addJournalKnowledge": {
            "title": "The Bog Stone",
            "text": "The Bog Stone asks a riddle; answering it raises an old causeway."
          },
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_answer_eel": {
          "text": "She sniffs the eel, approves, and leans close. 'What swallows the bold and keeps you a mile? Look down, child. You are standing in it.'",
          "consumeItem": "item_dev_smoked_eel",
          "setFlags": {
            "rook_told_answer": true
          },
          "addJournalKnowledge": {
            "title": "The bog's own riddle",
            "text": "Grandmother Rook says the answer to the Bog Stone is the bog itself."
          },
          "choices": [
            {
              "label": "The bog itself...",
              "target": "root"
            }
          ]
        },
        "node_answer_free": {
          "text": "'Oh, you've nice manners.' She taps her foot on the soggy ground. 'The answer's under your feet, dear.'",
          "setFlags": {
            "rook_told_answer": true
          },
          "addJournalKnowledge": {
            "title": "The bog's own riddle",
            "text": "Grandmother Rook says the answer to the Bog Stone is the bog itself."
          },
          "choices": [
            {
              "label": "Under my feet...",
              "target": "root"
            }
          ]
        },
        "node_answer_no": {
          "text": "'Ha! Nothing's free in the Moss.' She goes back to her fishing. Maybe bring her something tasty.",
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        },
        "node_chapel": {
          "text": "The Tide Warden's chapel sank there when my grandmother's grandmother was a girl. They kept a spare lighthouse key on the altar, if you believe that sort of thing.",
          "revealRumour": "loc_dev_sunken_chapel",
          "addJournalKnowledge": {
            "title": "The Sunken Chapel",
            "text": "A sunken chapel of the Tide Warden lies under the Old Moss; it may hold a spare lighthouse key."
          },
          "choices": [
            {
              "label": "Back to other things.",
              "target": "root"
            }
          ]
        }
      }
    },
    "dialogue_dev_jory": {
      "greeting": "Lost, are we? The road's that way. Everything this way is fish.",
      "nodes": {
        "root": {
          "text": "Jory Vane leans on a crate marked FISH, flipping a knife.",
          "choices": [
            {
              "label": "You run this cove, don't you?",
              "target": "node_offer",
              "condition": {
